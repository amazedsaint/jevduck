{
  "name": "microduck-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3177",
    "build": "npm run build:simulator && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
